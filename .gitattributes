# Normalize line endings for every text file.
#
# Without this, the repository kept a mix of CRLF and LF files, so any tool that
# rewrote a file (or any contributor on Windows) turned whole-file line-ending
# diffs into `git status`. Pinning LF keeps diffs limited to real changes.
* text=auto eol=lf

# Files that must stay byte-exact.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.gz binary
*.tgz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.node binary

# Lockfiles are generated by npm; keep npm's own output verbatim.
package-lock.json -diff

# Keep shell scripts executable and LF so they run on every platform.
*.sh text eol=lf
*.bash text eol=lf
