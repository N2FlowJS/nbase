{
  "name": "@n2flowjs/nbase",
  "version": "0.2.0",
  "description": "Partitioned vector database with HNSW indexing, clustering and a REST API for similarity search",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "!dist/server/daemon/**",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "dev": "concurrently \"tsc -p tsconfig.build.json --watch\" \"nodemon dist/server/index.js\"",
    "start": "node dist/server/index.js",
    "service:install": "node dist/scripts/service.js install",
    "service:uninstall": "node dist/scripts/service.js uninstall",
    "service:start": "node dist/scripts/service.js start",
    "service:stop": "node dist/scripts/service.js stop",
    "benchmark": "ts-node test/run-benchmarks.ts",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "test:coverage": "c8 mocha",
    "docs": "typedoc",
    "docs:serve": "http-server docs -p 8080 -c-1",
    "prepublishOnly": "npm run clean && npm run build",
    "npm:publish": "npm publish --access public"
  },
  "keywords": [
    "vector",
    "vector-database",
    "database",
    "similarity-search",
    "nearest-neighbor",
    "embeddings",
    "hnsw",
    "knn",
    "clustering",
    "kmeans",
    "ai",
    "mcp"
  ],
  "author": "n2flowjs",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "lru-cache": "^11.1.0"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/chai": "^4.3.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.3.1",
    "@types/node-windows": "^0.1.6",
    "@types/sinon": "^17.0.4",
    "@types/supertest": "^6.0.3",
    "c8": "^10.1.2",
    "chai": "^4.3.7",
    "concurrently": "9.1.2",
    "eslint": "^9.23.0",
    "globals": "^16.3.0",
    "http-server": "^14.1.1",
    "mocha": "^10.8.2",
    "nodemon": "3.1.9",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "sinon": "^20.0.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n2flowjs/nbase.git"
  },
  "bugs": {
    "url": "https://github.com/n2flowjs/nbase/issues"
  },
  "homepage": "https://github.com/n2flowjs/nbase#readme",
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "^1.1.18"
    },
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  }
}
