# Copy to `.env` and adjust for your environment. Never commit `.env`.

# Network binding and port for the nbased HTTP/1.1 REST server.
NBASE_HOST=0.0.0.0
PORT=1307

# Persistent WAL data directory (inside Docker, overridden to /data volume).
NBASE_DATA_DIR=./database

# Database & index tuning
NBASE_DIM=128
NBASE_METRIC=euclidean
NBASE_WORKERS=4
NBASE_CACHE_SIZE=256

# Security & rate limiting
NBASE_API_KEY=
NBASE_RATE_LIMIT=0
NBASE_CORS_ORIGIN=
